---
import Base from '@theme/layouts/Base.astro';
import ContactForm from '@theme/components/ContactForm.astro';
---
<Base title="Contact | The Sentience Saga" description="Contact M. D. Cooper about The Sentience Saga and Aeon 14.">
  <Fragment slot="breadcrumbs"><a href="/">The Sentience Saga</a> / Contact</Fragment>
  <p class="eyebrow">GET IN TOUCH</p>
  <h1>Contact</h1>
  <p class="lede">Questions about the books, the Sentience Saga, or Aeon 14? Send a message below.</p>
  <section class="card form-card">
    <ContactForm />
  </section>
</Base>
