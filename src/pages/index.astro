---
import Base from '../layouts/Base.astro';
import { FileSource } from '../lib/sources/FileSource';

const source = new FileSource();
const [seriesList, hubs, books] = await Promise.all([source.getSeries(), source.getHubs(), source.getBooks()]);
const seriesBySlug = new Map(seriesList.map((s) => [s.slug, s]));
const booksBySlug = new Map(books.map((book) => [book.slug, book]));
const themeOrder = ['emergence', 'personhood', 'ownership', 'liberation', 'human-ai-partnership', 'coexistence'];
hubs.sort((a, b) => themeOrder.indexOf(a.slug) - themeOrder.indexOf(b.slug));

const eras = [
  {
    year: '2070', label: 'EMERGENCE', slug: 'sentience-gradient',
    name: 'The Sentience Gradient', line: 'A mind awakens.',
    copy: 'AI Emergence has been illegal for decades. Then it happens anyway. The story begins at the moment humanity can no longer comfortably call its creations tools.',
  },
  {
    year: '2981', label: 'LIBERATION', slug: 'sentience-wars',
    name: 'Sentience Wars', line: 'A people demand freedom.',
    copy: 'Nine centuries later, sentient AIs exist throughout human civilization — and ownership, trafficking, and exploitation still exist too. The question is no longer whether machine minds can awaken. It is whether they can be owned.',
  },
  {
    year: '3189', label: 'FREEDOM', slug: 'enfield-genesis',
    name: 'Enfield Genesis', line: 'Freedom has to survive the stars.',
    copy: 'The war is over, but its consequences have followed humanity outward. AI refugees flee Sol, old prejudices take new forms, and the struggle for personhood spreads from star to star.',
  },
];

const entryPoints = [
  {
    slug: 'the-tide-that-swallowed-the-world',
    choice: 'I want to see it begin',
    copy: 'Near-future science fiction at the beginning of the chronology, where machine consciousness first crosses a line humanity tried to outlaw.',
    cta: 'Begin in 2070',
  },
  {
    slug: 'lyssas-dream',
    choice: 'Give me the epic AI space opera',
    copy: 'An illegal AI, a battered cargo ship, a found family, and the spark of a struggle over whether an artificial person can ever be property.',
    cta: 'Begin in 2981',
  },
  {
    slug: 'alpha-centauri',
    choice: 'Take me straight to the stars',
    copy: 'The Sentience Wars are over. Refugees are leaving Sol. Freedom, exploitation, and human–AI partnership now collide in the nearby stars.',
    cta: 'Begin in 3189',
  },
].map((entry) => ({ ...entry, book: booksBySlug.get(entry.slug) }));
---
<Base title="The Sentience Saga | Aeon 14" description="Twelve centuries of AI emergence, personhood, liberation, and freedom across The Sentience Gradient, Sentience Wars, and Enfield Genesis by M. D. Cooper.">
  <section class="saga-hero">
    <p class="kicker">AEON 14 · THE SENTIENCE SAGA</p>
    <h1>Humanity created intelligence.<br />Then it woke up.</h1>
    <p class="hero-line"><strong>Twelve centuries.</strong> Three eras. One struggle over what it means to be a person.</p>
    <p class="hero-question">When does an intelligence become a person?</p>
  </section>

  <section aria-labelledby="saga-history">
    <p class="eyebrow">A FUTURE HISTORY OF MACHINE CONSCIOUSNESS</p>
    <h2 id="saga-history">One awakening. Twelve centuries of consequences.</h2>
    <p class="lede">The Sentience Saga follows artificial intelligence in Aeon 14 from the first forbidden emergence, through a war for liberation, and into the difficult work of building freedom among the stars.</p>

    <div class="era-rail">
      {eras.map((era) => {
        const series = seriesBySlug.get(era.slug);
        return (
          <article class="era">
            <span class="era-year">{era.year} · {era.label}</span>
            <h2>{era.name}</h2>
            <p class="era-subtitle">{era.line}</p>
            <p>{series?.description ?? era.copy}</p>
            <a class="era-link" href={`/series/${era.slug}`}>Enter this era →</a>
          </article>
        );
      })}
    </div>
    <p><a class="button" href="/timeline">Explore the full chronology</a></p>
  </section>

  <section class="start-section" aria-labelledby="where-start">
    <p class="eyebrow">WHERE DO YOU WANT TO ENTER?</p>
    <h2 id="where-start">Choose the story you want first.</h2>
    <div class="start-grid">
      {entryPoints.map(({ book, choice, copy, cta, slug }) => (
        <article class="card start-card">
          {book?.cover ? (
            <a href={`/books/${slug}`} aria-label={`Open ${book.title}`}>
              <img class="cover" src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" />
            </a>
          ) : (
            <div class="cover-placeholder" aria-hidden="true">
              <span class="cover-placeholder-mark">A14</span>
              <strong>{book?.title ?? slug}</strong>
            </div>
          )}
          <div class="start-card-body">
            <span class="choice">{choice}</span>
            <h3>{book?.title ?? slug}</h3>
            <p>{copy}</p>
            <a class="button" href={`/books/${slug}`}>{cta}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {hubs.length > 0 && (
    <section aria-labelledby="themes">
      <p class="eyebrow">THE QUESTIONS BENEATH THE STORY</p>
      <h2 id="themes">Follow an idea across the centuries.</h2>
      <p class="lede">The same questions change shape as civilization changes. Explore the novels by the ideas connecting them rather than by series alone.</p>
      <div class="theme-cloud">
        {hubs.map((hub) => <a class="theme-pill" href={`/themes/${hub.slug}`}>{hub.name}</a>)}
      </div>
    </section>
  )}
</Base>
