---
import Base from '../../layouts/Base.astro';
import { FileSource } from '../../lib/sources/FileSource';
const source = new FileSource();
const hubs = await source.getHubs();
const themeOrder = ['emergence', 'personhood', 'ownership', 'liberation', 'human-ai-partnership', 'coexistence'];
hubs.sort((a, b) => themeOrder.indexOf(a.slug) - themeOrder.indexOf(b.slug));
---
<Base title="Themes | The Sentience Saga" description="Explore the Sentience Saga by ideas: AI emergence, personhood, ownership, liberation, partnership, and coexistence.">
  <Fragment slot="breadcrumbs"><a href="/">The Sentience Saga</a> / Themes</Fragment>
  <p class="eyebrow">THE QUESTIONS BENEATH THE STORY</p>
  <h1>Follow the idea across twelve centuries.</h1>
  <p class="lede">Machine consciousness begins as an anomaly and becomes a civilization. These six questions form the intellectual spine of the saga.</p>
  {hubs.length > 0 ? <div class="series-grid">
    {hubs.map((hub, index) => <article class="card series-card">
      <p class="book-number">{String(index + 1).padStart(2, '0')} · THE SENTIENCE QUESTION</p>
      <h2><a href={`/themes/${hub.slug}`}>{hub.name}</a></h2>
      <p class="series-description">{hub.description}</p>
      <a class="era-link" href={`/themes/${hub.slug}`}>Follow the theme →</a>
    </article>)}
  </div> : <p class="timeline-note">Theme collections are being populated now.</p>}
</Base>
