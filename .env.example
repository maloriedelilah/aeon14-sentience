# Build-time public key. Set this as a Cloudflare build variable to enable /contact.
TURNSTILE_SITE_KEY=

# Cloudflare Worker runtime variables/secrets for the contact form.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# EmailOctopus newsletter provider (selected in src/config.ts).
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=
